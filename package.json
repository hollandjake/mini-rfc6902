{
  "name": "mini-rfc6902",
  "version": "0.8.0",
  "description": "TypeScript implementation of RFC6902 with mini-rfc6902 format support",
  "keywords": [
    "diff",
    "json patch",
    "rfc6902"
  ],
  "homepage": "https://github.com/hollandjake/mini-rfc6902#readme",
  "bugs": {
    "url": "https://github.com/hollandjake/mini-rfc6902/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollandjake/mini-rfc6902.git"
  },
  "license": "MIT",
  "author": "Jake Holland",
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "unpkg": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "bun build.ts",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "attw --pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-istanbul": "^4.1.10",
    "bson": "^7.3.1",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "bson": "*"
  },
  "peerDependenciesMeta": {
    "bson": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=11.0.0"
  },
  "readme": "./README.md"
}
